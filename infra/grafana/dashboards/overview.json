            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (group) ({__name__=~\"kafka_consumer_group_lag(_ratio)?\"})",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "id": 6,
