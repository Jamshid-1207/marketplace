// Схема <%= name %>_db (ADR-0004). Таблицы outbox и processed_events принадлежат libs (SD-01, п. 6):
// их DDL — в первой миграции, а модели здесь, чтобы prisma migrate dev не видел расхождений.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Outbox {
  id          BigInt    @id @default(autoincrement())
  eventId     String    @unique @map("event_id") @db.Uuid
  topic       String
  messageKey  String    @map("message_key")
  payload     Json
  headers     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, id], map: "outbox_unpublished")
  @@map("outbox")
}

model ProcessedEvent {
  handler     String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([handler, eventId])
  @@index([processedAt], map: "processed_events_processed_at")
  @@map("processed_events")
}
