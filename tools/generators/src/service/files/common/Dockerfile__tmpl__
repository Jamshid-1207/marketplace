# Образ сервиса <%= name %> (SD-01, п. 7). Собирается из корня монорепо:
#   docker build -f apps/<%= name %>/Dockerfile --target runtime .
ARG NODE_IMAGE=<%= nodeImage %>

FROM ${NODE_IMAGE} AS base
# openssl нужен движку миграций Prisma на Alpine
RUN apk add --no-cache openssl && npm install -g pnpm@<%= versions.pnpm %> && npm cache clean --force
WORKDIR /repo
ENV NX_DAEMON=false NX_NO_CLOUD=true CI=true

# зависимости ставятся по lockfile до копирования исходников: слой переиспользуется
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch
COPY . .
RUN pnpm install --offline --frozen-lockfile

FROM deps AS build
RUN pnpm nx run @repo/<%= name %>:build --output-style=static
# только production-зависимости сервиса и нужные ему workspace-пакеты
RUN pnpm --filter @repo/<%= name %> deploy --legacy --prod /out

# одноразовый шаг миграций (ADR-0004, п. 6): Prisma CLI и prisma/
FROM deps AS migrate
WORKDIR /repo/apps/<%= name %>
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out .
USER node
EXPOSE 3000
# instrumentation грузится до main.js: OpenTelemetry должен подменить модули до их импорта
CMD ["node", "--require", "./dist/instrumentation.js", "dist/main.js"]
