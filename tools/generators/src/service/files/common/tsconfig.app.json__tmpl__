{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "emitDeclarationOnly": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.int-spec.ts", "src/testing/**"],
  // project references на libs: то же, что проставил бы nx sync
  "references": [
<%- libs.map((lib) => `    { "path": "../../libs/${lib}/tsconfig.lib.json" }`).join(',\n') %>
  ]
}
