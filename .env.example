# Локальная разработка: cp .env.example .env. Пароли — только для локального стенда.

# Суперпользователь Postgres: только db-provision и ручное администрирование (ADR-0004, п. 1)
POSTGRES_PASSWORD=postgres

# Пароли пользователей сервисов: <NAME>_DB_PASSWORD для каждой строки infra/postgres/services.txt
AUTH_DB_PASSWORD=auth_local
CATALOG_DB_PASSWORD=catalog_local
ORDER_DB_PASSWORD=order_local
PAYMENT_DB_PASSWORD=payment_local
ERP_DB_PASSWORD=erp_local
CRM_DB_PASSWORD=crm_local
NOTIFICATION_DB_PASSWORD=notification_local

# Подпись webhook fake-psp → payment (SD-02, п. 3.2, 6.3): одна строка у обоих сервисов
PSP_WEBHOOK_SECRET=fake-psp-local-webhook-secret

# Тестовые пользователи libs/contracts/src/dev — общий пароль (SD-05, решение 6). Пусто — их нет
DEV_USER_PASSWORD=dev-password-1
# Первый админ платформы (SD-05, решение 5): оба или ни одного; пароль — от 12 символов
ADMIN_EMAIL=
ADMIN_PASSWORD=
