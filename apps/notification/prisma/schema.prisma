// Схема notification_db (ADR-0004). Таблицы outbox и processed_events принадлежат libs (SD-01, п. 6):
// их DDL — в первой миграции, а модели здесь, чтобы prisma migrate dev не видел расхождений.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Outbox {
  id          BigInt    @id @default(autoincrement())
  eventId     String    @unique @map("event_id") @db.Uuid
  topic       String
  messageKey  String    @map("message_key")
  payload     Json
  headers     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, id], map: "outbox_unpublished")
  @@map("outbox")
}

model ProcessedEvent {
  handler     String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([handler, eventId])
  @@index([processedAt], map: "processed_events_processed_at")
  @@map("processed_events")
}

// Read-модели для адресатов писем (SD-06, п. 6.1) и сами письма.

model Recipient {
  userId String @id @map("user_id") @db.Uuid
  email  String

  @@map("recipients")
}

model Shop {
  sellerId    String @id @map("seller_id") @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  name        String

  @@map("shops")
}

/// Покупатель заказа: `payment.refunded` его не несёт.
model Order {
  orderId String @id @map("order_id") @db.Uuid
  buyerId String @map("buyer_id") @db.Uuid

  @@map("orders")
}

/// Письмо. Адресат — пользователь, владелец магазина или покупатель заказа; email находится при
/// отправке: событие с ним могло ещё не дойти (решение 4 SD-06).
model Notification {
  id            String    @id @db.Uuid
  dedupKey      String    @unique @map("dedup_key")
  template      String
  recipientKind String    @map("recipient_kind")
  recipientId   String    @map("recipient_id") @db.Uuid
  data          Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt], map: "notifications_due")
  @@map("notifications")
}
