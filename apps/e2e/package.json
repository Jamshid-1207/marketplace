{
  "name": "@repo/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "nx": {
    "tags": [
      "type:e2e",
      "platform:node"
    ],
    "implicitDependencies": [
      "@repo/gateway",
      "@repo/auth-service",
      "@repo/catalog",
      "@repo/crm",
      "@repo/notification",
      "@repo/order",
      "@repo/payment",
      "@repo/erp",
      "@repo/fake-psp",
      "@repo/storefront",
      "@repo/backoffice"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bash apps/e2e/run.sh"
        },
        "dependsOn": [
          {
            "projects": [
              "@repo/contracts"
            ],
            "target": "build"
          }
        ],
        "cache": false
      }
    }
  },
  "dependencies": {
    "@repo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
