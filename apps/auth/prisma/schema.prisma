// Схема auth_db (ADR-0004). Таблицы outbox и processed_events принадлежат libs (SD-01, п. 6):
// их DDL — в первой миграции, а модели здесь, чтобы prisma migrate dev не видел расхождений.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Outbox {
  id          BigInt    @id @default(autoincrement())
  eventId     String    @unique @map("event_id") @db.Uuid
  topic       String
  messageKey  String    @map("message_key")
  payload     Json
  headers     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, id], map: "outbox_unpublished")
  @@map("outbox")
}

model ProcessedEvent {
  handler     String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([handler, eventId])
  @@index([processedAt], map: "processed_events_processed_at")
  @@map("processed_events")
}

/// Учётная запись (SD-05, п. 5.1). Email — в нижнем регистре (CHECK в миграции)
model User {
  userId       String   @id @map("user_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

/// Членство в магазине: в MVP не больше одного на пользователя (ADR-0006, п. 1)
model Membership {
  userId       String   @id @map("user_id") @db.Uuid
  sellerId     String   @map("seller_id") @db.Uuid
  /// seller — владелец, seller_manager — сотрудник
  role         String
  scopes       String[]
  /// из seller.*: pending | active | rejected | blocked
  sellerStatus String   @map("seller_status")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sellerId], map: "memberships_seller")
  @@map("memberships")
}

/// Refresh-токен: в базе только SHA-256; одно семейство — одна цепочка ротаций (SD-05, п. 5.2)
model RefreshToken {
  tokenId   String    @id @map("token_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId], map: "refresh_tokens_family")
  @@map("refresh_tokens")
}

/// Ключ подписи access-токенов (решение 1 SD-05): активный — один (частичный индекс в миграции)
model SigningKey {
  kid        String   @id
  privateJwk Json     @map("private_jwk")
  publicJwk  Json     @map("public_jwk")
  active     Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("signing_keys")
}
