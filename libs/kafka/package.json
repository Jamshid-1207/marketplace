{
  "name": "@repo/kafka",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@repo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql"
  ],
  "nx": {
    "tags": [
      "type:infra",
      "platform:node"
    ],
    "targets": {
      "test-integration": {
        "executor": "nx:run-commands",
        "options": {
          "command": "jest --config jest.int.config.cjs",
          "cwd": "{projectRoot}",
          "env": {
            "NODE_OPTIONS": "--experimental-vm-modules --disable-warning=ExperimentalWarning"
          }
        },
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/outbox": "workspace:*",
    "kafkajs": "2.2.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.0.0",
    "@repo/idempotency": "workspace:*",
    "@repo/testing": "workspace:*",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  }
}
