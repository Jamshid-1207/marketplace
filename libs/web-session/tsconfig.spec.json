{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./out-tsc/jest",
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "lib": ["es2024", "dom"],
